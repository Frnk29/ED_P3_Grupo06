<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Indicador de Estado (Turnos y Ganador) -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preparando juego..."
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#003366"
        android:layout_marginBottom="40dp"
        android:textAlignment="center" />

    <!-- Tablero 3x3 -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_marginBottom="40dp">

        <!-- Fila 0 del 3 en raya -->
        <Button
            android:id="@+id/btn0"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn1"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <!-- Fila 1 del 3 en raya -->
        <Button
            android:id="@+id/btn3"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn4"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <!-- Fila 2 del 3 en raya -->
        <Button
            android:id="@+id/btn6"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn7"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_margin="4dp" />

    </GridLayout>

    <!-- Botón para Volver al Inicio / Guardar Partida en caso de que el usuario decida volver antes de terminar -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="VOLVER AL INICIO"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#003366"
        android:textColor="@android:color/white" />
    <TextView
        android:id="@+id/tvHistorialJugadas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial: Sin jugadas"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginTop="12dp" />

</LinearLayout>